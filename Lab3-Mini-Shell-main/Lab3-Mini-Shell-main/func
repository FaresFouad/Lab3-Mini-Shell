void Command::execute()
{
    print();
    /*
        Write your code here
    */
    int currentInput = 0;
    for(int i = 0; i < _numberOfSimpleCommands; i++){
        int fd1[2] = {-1, -1};
        int fd[2] = {-1, -1};
        if(i + 1 < _numberOfSimpleCommands){
            if(i == 0){
                pipe(fd1);
            }
            else{
                pipe(fd);
            }
        }
        int pid = fork();
        if(pid == 0){
            if(fd1[0] != -1 && i == 0){
                dup2(fd1[1], 1);
                close(fd1[0]);
                close(fd1[1]);
            }
            else if(fd1[0] != -1 && i > 0){
                dup2(fd1[0], 0);
                close(fd1[0]);
                close(fd1[1]);
                dup2(fd[1], 1);
                close(fd[0]);
                close(fd[1]);
                
            }
            if(execvp(_simpleCommands[i]->_arguments[0], _simpleCommands[i]->_arguments) == -1){
                perror("Error: Command does not exist.");
                exit(1);
            }
        }
        else if(pid < 0){
            perror("Error: Fork failed.");
            exit(1);
        }
        else{
            if(fd1[0] != -1 && i == 0){
                currentInput = fd1[0];
                close(fd1[0]);
                close(fd1[1]);
            }
            else if(fd1[0] != -1 && i > 0){
                close(fd1[0]);
                close(fd1[1]);
                currentInput = fd[0];
            }
            if(fd[0] != -1){
                close(fd[0]);
                close(fd[1]);
            }
            if(!_background){
                waitpid(pid, NULL, 0);
            }
        }
}
    clear();
    prompt();


}
